{
  "name": "snapmon-functions",
  "version": "0.1.0",
  "private": true,
  "description": "SnapMon Cloud Functions (server-authoritative game logic)",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "copy-config": "node scripts/copy-config.js",
    "build": "npm run copy-config && tsc",
    "lint": "eslint src",
    "test": "npm run copy-config && vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
