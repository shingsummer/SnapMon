rules_version = '2';

// 企画書 v1.3 §3.6 / §14.3
// - 出自写真（source/）は本人のみ読める。書き込みは Functions のみ（generateMonster がアップロードを受ける）
// - 共有アート（art/）はサインイン済みなら誰でも読める
// - 専用アート（custom/）は本人のみ
service firebase.storage {
  match /b/{bucket}/o {
    match /source/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /art/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /custom/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
